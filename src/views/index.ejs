                console.log('  - Emoji circles:', allEmojiCircles.length);
                console.log('  - Tooltips:', allTooltips.length);
                
                allUserItems.forEach((item, index) => {
                    item.style.zIndex = 'var(--z-content)';
                    console.log(`  ✅ User item ${index} z-index set to var(--z-content)`);
