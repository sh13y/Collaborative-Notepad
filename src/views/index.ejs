            userItem.className = 'user-item';
            userItem.setAttribute('data-user-id', userId);
            
            userItem.innerHTML = `
                <div class="user-emoji-circle">
                    ${userInfo.emoji || '👤'}
                    <div class="user-status-dot ${status}"></div>
                </div>
                <div class="user-tooltip">
                    <strong>${userInfo.username || 'Anonymous User'}</strong><br>
                    ${deviceInfo}<br>
                    <small>Status: ${status}</small>
                </div>
            `;
            
            // Add event listeners for debugging tooltip hover
            const emojiCircle = userItem.querySelector('.user-emoji-circle');
            const tooltip = userItem.querySelector('.user-tooltip');
            
            console.log('🔍 Debugging tooltip for user:', userId);
            console.log('  - Emoji circle element:', emojiCircle);
            console.log('  - Tooltip element:', tooltip);
            console.log('  - User info:', userInfo);
            
            // Add mouse event listeners for debugging
            emojiCircle.addEventListener('mouseenter', () => {
                console.log('🖱️ MOUSE ENTER on emoji circle for user:', userId, userInfo.username);
                console.log('  - Tooltip element:', tooltip);
                console.log('  - Tooltip computed styles:', tooltip ? getComputedStyle(tooltip) : 'No tooltip');
                console.log('  - Tooltip classes:', tooltip ? tooltip.className : 'No tooltip');
                
                // Force show tooltip for debugging
                if (tooltip) {
                    tooltip.style.opacity = '1';
                    tooltip.style.visibility = 'visible';
                    console.log('🔧 FORCED tooltip to show for:', userInfo.username);
                }
            });
            
            emojiCircle.addEventListener('mouseleave', () => {
                console.log('🖱️ MOUSE LEAVE on emoji circle for user:', userId, userInfo.username);
                
                // Force hide tooltip for debugging
                if (tooltip) {
                    tooltip.style.opacity = '0';
                    tooltip.style.visibility = 'hidden';
                    console.log('🔧 FORCED tooltip to hide for:', userInfo.username);
                }
            });
            
