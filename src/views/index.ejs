<!DOCTYPE html>
<html lang="en" class="light">
<head>
    <meta charset="UTF-8">
    <title>Collaborative Notepad - Real-Time Collaborative Note Taking | Free & Open Source</title>
    
    <!-- SEO Meta Tags -->
    <meta name="description" content="Free real-time collaborative notepad for teams, students, and remote workers. Share notes instantly, no sign-up required. Open-source, secure, and ephemeral.">
    <meta name="keywords" content="collaborative notepad, real-time notes, shared notepad, online notepad, team collaboration, note sharing, free notepad, open source notepad, markdown editor">
    <meta name="author" content="sh13y">
    <meta name="robots" content="index, follow">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    
    <!-- Canonical URL -->
    <link rel="canonical" href="https://collabnote.app/<%= note.url %>">
    
    <!-- Open Graph & Social Cards -->
    <meta property="og:type" content="website">
    <meta property="og:title" content="Collaborative Notepad - Real-Time Note Sharing">
    <meta property="og:description" content="Free real-time collaborative notepad. Share notes instantly, no sign-up required.">
    <meta property="og:url" content="https://collabnote.app/<%= note.url %>">
    <meta property="og:site_name" content="Collaborative Notepad">
    <meta property="og:image" content="https://collabnote.app/assets/og-image.png">
    
    <!-- Theme & Icons -->
    <meta name="theme-color" content="#606c38">
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 512 512'><path fill='%23606c38' d='M471.6 21.7c-21.9-21.9-57.3-21.9-79.2 0L362.3 51.7l97.9 97.9 30.1-30.1c21.9-21.9 21.9-57.3 0-79.2L471.6 21.7zm-299.2 220c-6.1 6.1-10.8 13.6-13.5 21.9l-29.6 88.8c-2.9 8.6-.6 18.1 5.8 24.6s15.9 8.7 24.6 5.8l88.8-29.6c8.2-2.7 15.7-7.4 21.9-13.5L437.7 172.3 339.7 74.3 172.4 241.7zM96 64C43 64 0 107 0 160V416c0 53 43 96 96 96H352c53 0 96-43 96-96V320c0-17.7-14.3-32-32-32s-32 14.3-32 32v96c0 17.7-14.3 32-32 32H96c-17.7 0-32-14.3-32-32V160c0-17.7 14.3-32 32-32h96c17.7 0 32-14.3 32-32s-14.3-32-32-32H96z'/></svg>"/>

    <!-- Google Fonts & Tailwind CDN -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        darkMode: 'class',
        theme: {
          extend: {
            colors: {
              earth: {
                cream: '#fefae0',
                creamDark: '#f7f4d3',
                olive: '#606c38',
                oliveDark: '#4d572c',
                forest: '#283618',
                burnt: '#bc6c25',
                terracotta: '#dda15e',
                muted: '#737f51',
                darkBg: '#182012',
                darkCard: '#212c1a',
                darkEditor: '#1c2616',
                darkBorder: '#354522',
              }
            },
            fontFamily: {
              sans: ['"Plus Jakarta Sans"', 'sans-serif'],
              mono: ['"JetBrains Mono"', 'monospace'],
            }
          }
        }
      }
    </script>
    <link rel="stylesheet" href="/css/theme.css">
    
    <!-- JSON-LD Structured Data for SEO -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "Collaborative Notepad",
      "url": "https://collabnote.app/",
      "description": "Free real-time collaborative notepad with live cursor synchronization.",
      "applicationCategory": "ProductivityApplication",
      "operatingSystem": "Web Browser",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "creator": { "@type": "Person", "name": "sh13y" }
    }
    </script>
</head>
<body class="bg-earth-cream text-earth-forest font-sans h-screen flex flex-col overflow-hidden transition-colors duration-300 antialiased selection:bg-earth-terracotta/30 selection:text-earth-forest dark:bg-earth-darkBg dark:text-earth-cream">

  <!-- Main Top Header -->
  <header class="sticky top-0 z-40 bg-earth-cream/90 dark:bg-earth-darkBg/90 backdrop-blur-md border-b border-earth-olive/20 dark:border-earth-darkBorder transition-colors flex-shrink-0">
    <div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 py-2 sm:py-3 flex items-center justify-between gap-2 sm:gap-4">
      
      <!-- Brand (compact on mobile) -->
      <a href="/" class="flex items-center gap-2 group text-decoration-none flex-shrink-0">
        <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-xl bg-earth-olive text-earth-cream flex items-center justify-center shadow-md shadow-earth-olive/20 ring-2 ring-earth-olive/30 group-hover:scale-105 transition-transform">
          <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
          </svg>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h1 class="text-sm sm:text-lg font-bold tracking-tight text-earth-forest dark:text-earth-cream">Collaborative Notepad</h1>
            <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-earth-olive/15 text-earth-oliveDark dark:bg-earth-olive/30 dark:text-earth-terracotta uppercase tracking-wider">v3.0</span>
          </div>
          <p class="text-[10px] sm:text-xs text-earth-forest/70 dark:text-earth-cream/60">Real-time collaborative note editor</p>
        </div>
      </a>

      <!-- Custom URL Slug Bar (flexible, no domain prefix) -->
      <div class="flex-1 max-w-xs sm:max-w-lg min-w-0">
        <div class="relative flex items-center rounded-xl bg-white/80 dark:bg-earth-darkCard/80 border border-earth-olive/25 dark:border-earth-darkBorder shadow-sm focus-within:border-earth-olive focus-within:ring-2 focus-within:ring-earth-olive/20 transition-all p-0.5 sm:p-1">
          <div class="pl-2 pr-1 flex items-center pointer-events-none text-earth-forest/50 dark:text-earth-cream/40">
            <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-earth-olive" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>
            </svg>
          </div>
          <input type="text" id="urlSlugInput" value="<%= note.url %>" class="w-full bg-transparent border-0 font-mono text-xs font-medium text-earth-forest dark:text-earth-cream focus:outline-none focus:ring-0 px-1 py-1" placeholder="room-name">
          <div class="flex items-center gap-0.5 flex-shrink-0">
            <!-- Set URL (icon-only) -->
            <button id="setUrlBtn" class="p-1.5 sm:p-2 rounded-lg bg-earth-olive/10 hover:bg-earth-olive text-earth-olive hover:text-white dark:bg-earth-olive/30 dark:hover:bg-earth-olive transition-colors" title="Set URL">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
            </button>
            <!-- Copy Link (icon-only) -->
            <button id="copyLinkBtn" class="p-1.5 sm:p-2 rounded-lg bg-earth-burnt/10 hover:bg-earth-burnt text-earth-burnt hover:text-white dark:bg-earth-burnt/20 dark:hover:bg-earth-burnt transition-colors" title="Copy link">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
              </svg>
            </button>
          </div>
        </div>
      </div>

      <!-- Action Items & Presence -->
      <div class="flex items-center gap-1.5 sm:gap-3 flex-shrink-0">
        <!-- Online active users indicator pill -->
        <div id="statusIndicator" class="flex items-center bg-white/80 dark:bg-earth-darkCard border border-earth-olive/20 dark:border-earth-darkBorder rounded-full pl-2 pr-2 sm:pr-3 py-1 gap-1.5 shadow-sm">
          <span class="flex h-2 w-2 relative">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-500 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          <span id="userCount" class="text-[10px] sm:text-xs font-semibold text-earth-forest dark:text-earth-cream whitespace-nowrap">1</span>
          
          <!-- Collaborator Avatars list (hidden on very small screens) -->
          <div id="collaboratorAvatars" class="hidden sm:flex -space-x-1.5 ml-0.5">
            <!-- Avatars injected dynamically by notepad.js -->
          </div>
        </div>

        <!-- New Note Action Button (icon-only on mobile) -->
        <button id="newNoteBtn" class="inline-flex items-center gap-1.5 p-2 sm:px-3.5 sm:py-1.5 rounded-xl bg-earth-olive hover:bg-earth-oliveDark text-earth-cream font-medium text-xs shadow-sm hover:shadow transition-all active:scale-95">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M12 4v16m8-8H4"/>
          </svg>
          <span class="hidden sm:inline">New Note</span>
        </button>

        <!-- Dark / Light Mode Toggle -->
        <button id="themeToggle" aria-label="Toggle Theme" class="p-1.5 sm:p-2 rounded-xl border border-earth-olive/20 dark:border-earth-darkBorder bg-white/80 dark:bg-earth-darkCard text-earth-forest dark:text-earth-cream hover:bg-earth-olive/10 dark:hover:bg-earth-olive/20 transition-colors">
          <!-- Sun Icon (Active when dark) -->
          <svg class="w-4 h-4 hidden dark:block text-earth-terracotta" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 9h-1m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
          </svg>
          <!-- Moon Icon (Active when light) -->
          <svg class="w-4 h-4 block dark:hidden text-earth-forest" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
          </svg>
        </button>
      </div>

    </div>
  </header>

  <!-- Document Meta Sub-header (hidden on mobile) -->
  <div class="hidden sm:flex max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 pt-2 pb-1 items-center justify-between gap-3 text-xs text-earth-forest/70 dark:text-earth-cream/70 flex-shrink-0">
    <div class="flex items-center gap-3">
      <span class="inline-flex items-center gap-1 font-mono text-[11px] bg-earth-olive/10 dark:bg-earth-olive/20 text-earth-oliveDark dark:text-earth-terracotta px-2 py-0.5 rounded-md font-semibold">
        UTF-8
      </span>
      <span class="flex items-center gap-1.5">
        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
        <span id="charCount">0 characters</span> &bull; <span id="wordCount">0 words</span>
      </span>
      <span class="hidden md:inline text-earth-forest/40 dark:text-earth-cream/30">|</span>
      <span class="hidden md:inline text-earth-muted dark:text-earth-cream/60">
        All changes sync instantly to connected peers
      </span>
    </div>

    <!-- Quick Actions -->
    <div class="flex items-center gap-2">
      <button id="clearBtn" class="p-1.5 rounded-lg hover:bg-red-500/10 hover:text-red-600 dark:hover:bg-red-500/20 text-earth-forest/60 dark:text-earth-cream/60 transition-colors" title="Clear notepad content">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Center Expansive Editor Canvas -->
  <main class="flex-1 max-w-7xl mx-auto w-full px-2 sm:px-6 lg:px-8 py-1 sm:py-2 pb-2 sm:pb-6 flex flex-col min-h-0 overflow-hidden">
    <div class="relative flex-1 flex flex-col rounded-xl sm:rounded-2xl bg-white/90 dark:bg-earth-darkEditor border border-earth-olive/25 dark:border-earth-darkBorder shadow-xl shadow-earth-olive/5 dark:shadow-black/40 backdrop-blur-sm overflow-hidden transition-all min-h-0">

      <!-- Editor Window Header Bar -->
      <div class="h-9 sm:h-11 px-3 sm:px-4 bg-earth-cream/50 dark:bg-earth-darkCard border-b border-earth-olive/15 dark:border-earth-darkBorder flex items-center justify-between flex-shrink-0">
        <div class="flex items-center gap-2">
          <!-- Window Dots -->
          <span class="w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-full bg-red-400/80 inline-block"></span>
          <span class="w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-full bg-amber-400/80 inline-block"></span>
          <span class="w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-full bg-emerald-400/80 inline-block"></span>
          <span class="ml-2 sm:ml-3 font-mono text-[10px] sm:text-xs text-earth-forest/60 dark:text-earth-cream/50 flex items-center gap-1">
            <svg class="w-3 h-3 sm:w-3.5 sm:h-3.5 text-earth-olive" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
            </svg>
            <span id="latencyDisplay" class="text-emerald-500 font-semibold">--ms</span>
          </span>
        </div>

        <!-- Floating Action Items inside Editor Toolbar -->
        <div class="flex items-center gap-1 sm:gap-2">
          <!-- Mobile-only: char/word count compact -->
          <span class="sm:hidden text-[9px] text-earth-forest/50 dark:text-earth-cream/40 font-mono">
            <span id="charCountMobile">0</span>c / <span id="wordCountMobile">0</span>w
          </span>
          <!-- Mobile-only: Clear button -->
          <button id="clearBtnMobile" class="sm:hidden p-1 rounded-lg hover:bg-red-500/10 hover:text-red-600 text-earth-forest/50 dark:text-earth-cream/50 transition-colors" title="Clear">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
            </svg>
          </button>
          <!-- Floating 'Copy content' button -->
          <button id="copyContentFloatingBtn" class="flex items-center gap-1 px-2 sm:px-3 py-1 text-[10px] sm:text-xs font-semibold rounded-lg bg-earth-forest text-earth-cream hover:bg-earth-olive dark:bg-earth-olive dark:hover:bg-earth-oliveDark shadow-sm hover:shadow transition-all active:scale-95" title="Copy note text">
            <svg class="w-3 h-3 sm:w-3.5 sm:h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
            </svg>
            <span class="hidden sm:inline">Copy content</span>
          </button>
        </div>
      </div>

      <!-- Editor Content & Collaborative Cursors Overlay Container -->
      <div class="relative flex-1 flex overflow-hidden min-h-0">
        <!-- Collaborative Cursor Layer Container -->
        <div id="cursor-container" class="absolute inset-0 pointer-events-none overflow-hidden z-20"></div>

        <!-- Editable Code/Text Area -->
        <textarea id="notepad" spellcheck="false" class="w-full h-full p-3 sm:p-5 font-mono text-sm leading-relaxed bg-transparent text-earth-forest dark:text-earth-cream resize-none focus:outline-none focus:ring-0 border-0 selection:bg-earth-terracotta/30 selection:text-earth-forest dark:selection:text-earth-cream" placeholder="Start typing your notes here... Everyone on this link can collaborate in real-time."><%= note.content %></textarea>
      </div>

      <!-- Live Notification Toast Bar -->
      <div id="toastNotification" class="hidden absolute bottom-3 right-3 sm:bottom-4 sm:right-4 bg-earth-forest text-earth-cream dark:bg-earth-olive dark:text-white px-3 py-1.5 sm:px-4 sm:py-2 rounded-xl shadow-lg border border-earth-terracotta/30 text-xs flex items-center gap-2 z-50 transition-all">
        <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
        </svg>
        <span id="toastMessage">Copied to clipboard!</span>
      </div>

    </div>
  </main>

  <!-- Minimal Clean Footer (hidden on mobile) -->
  <footer class="mt-auto border-t border-earth-olive/15 dark:border-earth-darkBorder py-2 sm:py-3 bg-earth-cream/60 dark:bg-earth-darkBg/60 backdrop-blur-sm flex-shrink-0">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-2 text-xs text-earth-forest/70 dark:text-earth-cream/70">
      
      <!-- Left: Credit -->
      <div class="flex items-center gap-2">
        <div class="w-2 h-2 rounded-full bg-earth-burnt"></div>
        <span>2026 | Made with ❤️ by <a href="https://github.com/sh13y" target="_blank" class="font-semibold hover:underline text-earth-forest dark:text-earth-cream">sh13y</a></span>
        <span class="text-earth-forest/40 dark:text-earth-cream/40">&bull;</span>
        <span>Open Source (MIT)</span>
      </div>

      <!-- Center / Right Links -->
      <div class="flex items-center gap-5 font-medium">
        <a href="https://github.com/sh13y/Collaborative-Notepad" target="_blank" class="hover:text-earth-burnt transition-colors flex items-center gap-1">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
          GitHub
        </a>
      </div>

    </div>
  </footer>

  <!-- Socket.IO & Modular Client Script -->
  <script src="https://cdn.socket.io/4.7.4/socket.io.min.js"></script>
  <script src="/js/notepad.js"></script>
</body>
</html>
