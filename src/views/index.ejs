        // Get device information
        function getDeviceInfo() {
            const userAgent = navigator.userAgent;
            const isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(userAgent);
            const isTablet = /iPad|Android/i.test(userAgent) && !/Mobile/i.test(userAgent);
            
            let deviceType = 'Desktop';
            let browser = 'Unknown';
            
            if (isMobile) deviceType = 'Mobile';
            else if (isTablet) deviceType = 'Tablet';
            
            if (userAgent.includes('Chrome')) browser = 'Chrome';
            else if (userAgent.includes('Firefox')) browser = 'Firefox';
            else if (userAgent.includes('Safari')) browser = 'Safari';
            else if (userAgent.includes('Edge')) browser = 'Edge';
            
            return `${deviceType} • ${browser}`;
        }

        // Determine user status based on activity
        function getUserStatus(userId) {
            const user = userData.get(userId);
            if (!user) return 'disconnected';
            
            const now = Date.now();
            const timeSinceActivity = now - user.lastActivity;
            
            if (timeSinceActivity < 30000) { // Less than 30 seconds
                return 'online';
            } else if (timeSinceActivity < 300000) { // Less than 5 minutes
                return 'idle';
            } else {
                return 'disconnected';
            }
        }

        // Update user activity
        function updateUserActivity(userId) {
            const user = userData.get(userId);
            if (user) {
                user.lastActivity = Date.now();
                user.status = getUserStatus(userId);
                userData.set(userId, user);
            }
        }

        // Create user dropdown item - With device info on hover
