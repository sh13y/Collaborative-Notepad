    <script src="https://cdn.socket.io/4.7.4/socket.io.min.js"></script>
    <script>
        let browserId = localStorage.getItem('browserId');
        if (!browserId) {
            browserId = crypto.randomUUID();
            localStorage.setItem('browserId', browserId);
        }

        // Initialize socket with proper configuration
        const socket = io({
            query: {
                browserId: browserId
            },
            transports: ['websocket'],
            upgrade: false,
            reconnection: true,
            reconnectionAttempts: 5,
            reconnectionDelay: 1000
        });
        
        socket.on('connect', () => {
            console.log('✅ Connected to server:', socket.id);
            console.log('🔌 Socket connection established');
        });

        socket.on('connect_error', (error) => {
            console.error('❌ Connection error:', error);
        });
        
        // Debug: Log when socket is ready with retry mechanism
        function checkCursorSystemStatus() {
            const { textarea, cursorContainer } = getElements();
            console.log('━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━');
            console.log('🚀 CURSOR SYSTEM STATUS CHECK');
            console.log('Socket ID:', socket.id);
            console.log('Socket connected:', socket.connected);
            console.log('Textarea element:', textarea ? '✅ Found' : '❌ Not found');
            console.log('Cursor container:', cursorContainer ? '✅ Found' : '❌ Not found');
            console.log('Remote cursors:', remoteCursors.size, 'active');
            console.log('━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━');
            
            // If elements are missing, retry after a short delay
            if (!textarea || !cursorContainer) {
                console.log('⚠️ Elements missing, retrying in 500ms...');
                setTimeout(checkCursorSystemStatus, 500);
            }
        }
        
        // Initial check after 1 second
        setTimeout(checkCursorSystemStatus, 1000);

        // Add New Note button functionality
        document.getElementById('newNoteBtn').addEventListener('click', () => {
            try {
                window.location.href = '/new';
            } catch (error) {
                console.error('Error navigating to new note:', error);
                alert('Failed to create new note. Please try again.');
            }
        });

        const url = window.location.pathname.split('/').pop();
        let typingTimeout;

        socket.emit('joinNote', url);

        socket.on('loadNote', (note) => {
            document.getElementById('notepad').value = note.content;
        });

        socket.on('noteUpdated', (content) => {
            const textarea = document.getElementById('notepad');
            const cursorPosition = textarea.selectionStart;

            if (textarea.value !== content) {
                textarea.value = content;
            }

            textarea.selectionStart = cursorPosition;
            textarea.selectionEnd = cursorPosition;
        });

        socket.on('userCount', (count) => {
            const userCountElement = document.getElementById('userCount');
            const statusDot = document.querySelector('.status-dot');
            
            if (userCountElement) {
                userCountElement.textContent = count;
            }
            
            if (statusDot) {
                if (count > 1) {
                    statusDot.style.backgroundColor = '#fefae0';
                    statusDot.style.animationDuration = '1s';
                } else {
                    statusDot.style.backgroundColor = '#fefae0';
                    statusDot.style.animationDuration = '2s';
                }
            }
        });

        function debounce(func, delay) {
            return function(...args) {
                clearTimeout(typingTimeout);
                typingTimeout = setTimeout(() => func.apply(this, args), delay);
            };
        }

        let lastContent = '';

        document.getElementById('notepad').addEventListener('input', debounce(() => {
            const content = document.getElementById('notepad').value;

            if (content !== lastContent) {
                lastContent = content;
                socket.emit('updateNote', { url, content });
            }
            
            // Also emit cursor position immediately after text update
            if (textarea && typeof textarea.selectionStart === 'number') {
                socket.emit('cursor-move', {
                    position: textarea.selectionStart,
                    timestamp: Date.now()
                });
            }
        }, 100));

        document.getElementById('setCustomUrl').addEventListener('click', async () => {
            const customUrl = document.getElementById('customUrl').value.trim();
            if (customUrl === url) {
                alert("You're already using this URL.");
                return;
            }

            const response = await fetch(`/setCustomUrl/${url}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ url: customUrl })
            });

            const result = await response.json();

            if (result.success) {
                window.location.href = `/${customUrl}`;
            } else {
                alert(result.message);
            }
        });

        document.getElementById('themeToggle').addEventListener('click', () => {
            const body = document.body;
            const icon = document.querySelector('#themeToggle i');

            if (body.classList.contains('light-mode')) {
                body.classList.remove('light-mode');
                body.classList.add('dark-mode');
                icon.classList.remove('fa-moon');
                icon.classList.add('fa-sun');
                localStorage.setItem('theme', 'dark-mode');
            } else {
                body.classList.remove('dark-mode');
                body.classList.add('light-mode');
                icon.classList.remove('fa-sun');
                icon.classList.add('fa-moon');
                localStorage.setItem('theme', 'light-mode');
            }
        });

        window.onload = function() {
            const savedTheme = localStorage.getItem('theme');
            if (savedTheme) {
                document.getElementById('notepad').focus();
                document.body.classList.remove('light-mode', 'dark-mode');
                document.body.classList.add(savedTheme);
                const icon = document.querySelector('#themeToggle i');
                if (savedTheme === 'dark-mode') {
                    icon.classList.remove('fa-moon');
                    icon.classList.add('fa-sun');
                } else {
                    icon.classList.remove('fa-sun');
                    icon.classList.add('fa-moon');
                }
            }
        };

        document.getElementById('copyLink').addEventListener('click', async () => {
            try {
                await navigator.clipboard.writeText(window.location.href);
                const button = document.getElementById('copyLink');
                const icon = button.querySelector('i');
                
                // Visual feedback
                icon.classList.remove('fa-copy');
                icon.classList.add('fa-check');
                button.style.background = 'var(--sunset)';
                icon.style.color = 'var(--delft-blue)';
                
                // Reset after 2 seconds
                setTimeout(() => {
                    icon.classList.remove('fa-check');
                    icon.classList.add('fa-copy');
                    button.style.background = 'var(--burnt-sienna)';
                    icon.style.color = 'var(--eggshell)';
                }, 2000);
            } catch (err) {
                alert('Failed to copy link. Please try again.');
            }
        });
        document.getElementById('copyContent').addEventListener('click', async () => {
          try {
            const contentElement = document.getElementById('notepad');
            const textToCopy = contentElement.value;
            await navigator.clipboard.writeText(textToCopy);

            const button = document.getElementById('copyContent');
            const icon = button.querySelector('i');

            icon.classList.remove('fa-copy');
            icon.classList.add('fa-check');
            button.classList.add('copied');

            setTimeout(() => {
                icon.classList.remove('fa-check');
                icon.classList.add('fa-copy');
                button.classList.remove('copied');
            }, 2000);
          } catch(err) {
            alert("Failed to copy content. Please try again.");
          }
        });

        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/js/service-worker.js')
                    .then(registration => console.log('ServiceWorker registered'))
                    .catch(err => console.log('ServiceWorker registration failed:', err));
            });
        }

        // ============================================
        // Collaborative Cursor System Implementation
        // ============================================

        // Store remote cursor data: userId -> { element, color, emoji, lastUpdate, inactivityTimer }
        const remoteCursors = new Map();
        
        // Store user data for dropdown: userId -> { username, emoji, color, status, lastActivity, deviceInfo }
        const userData = new Map();
        
        // Get elements with fallback
        function getElements() {
            return {
                textarea: document.getElementById('notepad'),
                cursorContainer: document.getElementById('cursor-container')
            };
        }
        
        const { textarea, cursorContainer } = getElements();
        
        // My cursor data from server
        let myCursorData = null;

        // Throttle function for cursor movement events
        function throttle(func, limit) {
            let inThrottle;
            return function(...args) {
                if (!inThrottle) {
                    func.apply(this, args);
                    inThrottle = true;
                    setTimeout(() => inThrottle = false, limit);
                }
            };
        }


        // Calculate cursor position in pixels from character index with proper text wrapping support
        function getCursorCoordinates(textareaEl, caretPosition) {
            try {
                console.log('🔍 getCursorCoordinates called with:', { textareaEl: !!textareaEl, caretPosition });
                console.log('🔍 Textarea value:', JSON.stringify(textareaEl?.value));
                console.log('🔍 Textarea value length:', textareaEl?.value?.length);
                
                if (!textareaEl || caretPosition < 0) {
                    console.log('❌ Invalid parameters for cursor calculation');
                    return { x: -1, y: -1 }; // Return invalid coordinates
                }

                // Don't calculate coordinates for empty textarea
                if (!textareaEl.value || textareaEl.value.trim() === '') {
                    console.log('❌ Not calculating coordinates for empty textarea');
                    return { x: -1, y: -1 }; // Return invalid coordinates
                }

                const style = window.getComputedStyle(textareaEl);
                
                // Get font size for scaling calculations
                const fontSize = parseFloat(style.fontSize) || 16;
                const scaleFactor = fontSize / 16; // Base font size is 16px
                
                // Get textarea dimensions
                const textareaWidth = textareaEl.clientWidth;
                const paddingLeft = parseFloat(style.paddingLeft) || 0;
                const paddingTop = parseFloat(style.paddingTop) || 0;
                const lineHeight = parseFloat(style.lineHeight) || fontSize * 1.2;
                
                // Create a mirror div to simulate textarea rendering
                const mirror = document.createElement('div');
                mirror.style.position = 'absolute';
                mirror.style.top = '-9999px';
                mirror.style.left = '-9999px';
                mirror.style.width = `${textareaWidth}px`;
                mirror.style.font = style.font;
                mirror.style.fontSize = style.fontSize;
                mirror.style.fontFamily = style.fontFamily;
                mirror.style.fontWeight = style.fontWeight;
                mirror.style.letterSpacing = style.letterSpacing;
                mirror.style.lineHeight = style.lineHeight;
                mirror.style.padding = style.padding;
                mirror.style.border = style.border;
                mirror.style.boxSizing = style.boxSizing;
                mirror.style.whiteSpace = 'pre-wrap'; // Allow wrapping
                mirror.style.wordWrap = 'break-word';
                mirror.style.overflowWrap = 'break-word';
                
                // Set the text content up to the cursor position
                const textUpToCursor = textareaEl.value.substring(0, caretPosition);
                mirror.textContent = textUpToCursor;
                
                document.body.appendChild(mirror);
                
                // Get the position of the last character
                const range = document.createRange();
                const textNode = mirror.firstChild;
                
                if (textNode && textNode.textContent.length > 0) {
                    range.setStart(textNode, Math.min(caretPosition, textNode.textContent.length));
                    range.setEnd(textNode, Math.min(caretPosition, textNode.textContent.length));
                } else {
                    // Handle empty text case
                    range.setStart(mirror, 0);
                    range.setEnd(mirror, 0);
                }
                
                const rect = range.getBoundingClientRect();
                const mirrorRect = mirror.getBoundingClientRect();
                
                // Calculate relative position within the textarea
                const x = rect.left - mirrorRect.left + paddingLeft;
                const y = rect.top - mirrorRect.top + paddingTop;
                
                document.body.removeChild(mirror);
                
                console.log('✅ Coords: pos=' + caretPosition + ' x=' + x.toFixed(1) + ', y=' + y.toFixed(1) + ' (scale=' + scaleFactor.toFixed(2) + ', wrapped)');
                return { x, y, scaleFactor };
            } catch (error) {
                console.error('Error calculating cursor position:', error);
                return { x: 0, y: 0, scaleFactor: 1 };
            }
        }

        // Create cursor element (pin-style with emoji)
        function createCursorElement(userId, color, emoji, username) {
            const { cursorContainer } = getElements();
            if (!cursorContainer) {
                console.error('Cursor container not found');
                return null;
            }
            
            const cursorEl = document.createElement('div');
            cursorEl.className = 'remote-cursor';
            cursorEl.id = `cursor-${userId}`;
            cursorEl.style.setProperty('--user-color', color);
            cursorEl.setAttribute('title', username || 'Anonymous User');
            
            // Ensure cursor starts completely hidden
            cursorEl.style.display = 'none';
            cursorEl.style.opacity = '0';
            cursorEl.style.visibility = 'hidden';
            
            cursorEl.innerHTML = `
                <div class="cursor-pin">
                    <div class="cursor-pin-head">${emoji || '📍'}</div>
                    <div class="cursor-pin-point"></div>
                </div>
                <div class="cursor-tooltip">${username || 'Anonymous User'}</div>
            `;
            
            cursorContainer.appendChild(cursorEl);
            return cursorEl;
        }

        // Update cursor position with smooth animation
        function updateCursorPosition(userId, position, isInactive = false) {
            try {
                console.log('🎯 updateCursorPosition called for', userId, 'position:', position, 'inactive:', isInactive);
                console.log('🔍 DEBUG: Function called from:', new Error().stack?.split('\n')[2]);
                
                const cursorData = remoteCursors.get(userId);
                if (!cursorData || !cursorData.element) {
                    console.log('❌ No cursor data or element for', userId);
                    return;
                }

                const { textarea } = getElements();
                if (!textarea) {
                    console.log('❌ Textarea not available for cursor calculation');
                    return;
                }

                console.log('🔍 DEBUG: Textarea value:', JSON.stringify(textarea.value));
                console.log('🔍 DEBUG: Textarea value length:', textarea.value.length);
                console.log('🔍 DEBUG: Position:', position);

                // Only position cursors with valid positions
                if (position === null || position === undefined || position < 0) {
                    console.log('❌ Invalid position for cursor:', position);
                    return;
                }

                // Don't show cursors when textarea is empty (position 0 with no text)
                if (position === 0 && (!textarea.value || textarea.value.trim() === '')) {
                    console.log('❌ Not showing cursor for empty textarea at position 0');
                    return;
                }

                console.log('📏 Calculating coordinates...');
                console.log('📝 Textarea value length:', textarea.value.length);
                console.log('📝 Textarea value:', JSON.stringify(textarea.value));
                // Always use text position - no more idle positions
                const coords = getCursorCoordinates(textarea, position);
                console.log('📍 Calculated coords:', coords);
                
                // Check for invalid coordinates (empty textarea)
                if (coords.x === -1 && coords.y === -1) {
                    console.log('❌ Invalid coordinates - not positioning cursor');
                    return;
                }
                
                // Add offsets to position the pin tip at the end of the text
                // Apply dynamic scaling to offsets
                const baseXOffset = -21;
                const baseYOffset = -41;
                
                const scaledXOffset = baseXOffset * coords.scaleFactor;
                const scaledYOffset = baseYOffset * coords.scaleFactor;
                
                let offsetX = coords.x + scaledXOffset;
                let offsetY = coords.y + scaledYOffset;
                
                // Ensure cursor stays within textarea bounds
                const textareaRect = textarea.getBoundingClientRect();
                const cursorContainerRect = cursorContainer.getBoundingClientRect();
                
                // Convert to relative coordinates within cursor container
                const relativeX = offsetX;
                const relativeY = offsetY;
                
                // Clamp coordinates to prevent off-screen positioning
                const minX = 0;
                const maxX = textarea.clientWidth;
                const minY = -50; // Allow some space above for cursor
                const maxY = textarea.clientHeight + 20; // Allow some space below
                
                offsetX = Math.max(minX, Math.min(maxX, relativeX));
                offsetY = Math.max(minY, Math.min(maxY, relativeY));
                
                console.log('📍 After offset: x=' + offsetX + 'px, y=' + offsetY + 'px');
                
                // Additional safeguard: Don't position cursors near the copy button area
                // Copy button is typically in the bottom-right area
                const copyButtonAreaX = textarea.clientWidth - 100; // Right side of textarea
                const copyButtonAreaY = textarea.clientHeight - 50; // Bottom area of textarea
                
                if (offsetX > copyButtonAreaX && offsetY > copyButtonAreaY) {
                    console.log('❌ Cursor would be positioned near copy button - hiding cursor');
                    return;
                }
                
                const cursorEl = cursorData.element;
                
                // Use requestAnimationFrame for smooth updates
                requestAnimationFrame(() => {
                    if (cursorEl && cursorEl.style && cursorEl.parentNode) {
                        console.log('🎨 Setting cursor styles: left=' + offsetX + 'px, top=' + offsetY + 'px, scale=' + coords.scaleFactor.toFixed(2));
                        cursorEl.style.left = `${offsetX}px`;
                        cursorEl.style.top = `${offsetY}px`;
                        cursorEl.style.opacity = '1';
                        cursorEl.style.display = 'block';
                        cursorEl.style.visibility = 'visible';
                        cursorEl.style.transform = `scale(${coords.scaleFactor})`;
                        
                        // Remove inactive class since we're not using idle positions anymore
                        cursorEl.classList.remove('cursor-inactive');
                        
                        console.log('✅ Cursor DOM updated!');
                    } else {
                        console.log('❌ Cursor element, style, or parent not available');
                    }
                });

                // Update last activity timestamp
                cursorData.lastUpdate = Date.now();
                
                // Clear existing inactivity timer
                if (cursorData.inactivityTimer) {
                    clearTimeout(cursorData.inactivityTimer);
                }
                
                // Set fade after 5 seconds of inactivity, then hide after 10 seconds
                cursorData.inactivityTimer = setTimeout(() => {
                    if (cursorEl && cursorEl.style) {
                        cursorEl.style.opacity = '0.3';
                        // Keep cursor in same position, just reduce opacity
                        
                        // Hide cursor completely after additional 5 seconds
                        setTimeout(() => {
                            if (cursorEl && cursorEl.style) {
                                cursorEl.style.display = 'none';
                                cursorEl.style.opacity = '0';
                                cursorEl.style.visibility = 'hidden';
                                cursorData.isActive = false;
                            }
                        }, 5000); // Additional 5 seconds before hiding
                    }
                }, 5000); // 5 seconds - reduces opacity but stays in same position
                
            } catch (error) {
                console.error('Error updating cursor position:', error);
            }
        }

