                    position: updatedStyles.position,
                    zIndex: updatedStyles.zIndex,
                    display: updatedStyles.display,
                    visibility: updatedStyles.visibility,
                    opacity: updatedStyles.opacity,
                    top: updatedStyles.top,
                    right: updatedStyles.right,
                    transform: updatedStyles.transform
                });
                
                console.log('📍 Updated dropdown bounding rect:', dropdown.getBoundingClientRect());
                updateUsersDropdown();
            } else {
                console.log('❌ Dropdown is now hidden - after delay');
                
                // Reset textarea z-index to normal when dropdown is closed
                if (textarea) {
                    textarea.style.zIndex = 'var(--z-content)';
                    textarea.style.position = 'relative';
                    console.log('📝 Textarea z-index reset to var(--z-content) (normal)');
