        // Detect if dropdown would go off-screen and determine layout
        function detectDropdownLayout() {
            const statusIndicator = document.getElementById('statusIndicator');
            if (!statusIndicator) return 'horizontal';
            
            const rect = statusIndicator.getBoundingClientRect();
            const viewportWidth = window.innerWidth;
            const viewportHeight = window.innerHeight;
            
            // Estimate dropdown width based on user count
            const userCount = userData.size + (myCursorData ? 1 : 0);
            const estimatedDropdownWidth = Math.max(60, userCount * 40 + 20); // 40px per user + padding
            const estimatedDropdownHeight = 50; // Approximate height for horizontal layout
            
            // Check if dropdown would go off-screen horizontally
            const wouldGoOffScreenRight = (rect.left + estimatedDropdownWidth / 2) > viewportWidth;
            const wouldGoOffScreenLeft = (rect.left - estimatedDropdownWidth / 2) < 0;
            
            // Check if dropdown would go off-screen vertically
            const wouldGoOffScreenBottom = (rect.bottom + estimatedDropdownHeight) > viewportHeight;
            
            // Check if we're on mobile (screen width < 768px)
            const isMobile = viewportWidth < 768;
            
            // Determine layout based on conditions
            if (isMobile || wouldGoOffScreenRight || wouldGoOffScreenLeft || wouldGoOffScreenBottom) {
                console.log('📱 Using vertical layout - Mobile:', isMobile, 'Off-screen right:', wouldGoOffScreenRight, 'Off-screen left:', wouldGoOffScreenLeft, 'Off-screen bottom:', wouldGoOffScreenBottom);
                return 'vertical';
            } else {
                console.log('🖥️ Using horizontal layout');
                return 'horizontal';
            }
        }

        // Toggle dropdown visibility
        function toggleUsersDropdown() {
            const dropdown = document.getElementById('usersDropdown');
            const textarea = document.getElementById('notepad');
            
            if (!dropdown) {
                console.log('❌ Dropdown element not found!');
                return;
            }
            
            console.log('🔄 Toggling dropdown visibility');
            console.log('📍 Dropdown element:', dropdown);
            console.log('📍 Textarea element:', textarea);
            
            // Debug z-index and positioning
            const dropdownStyles = getComputedStyle(dropdown);
            const textareaStyles = getComputedStyle(textarea);
            
            console.log('📍 Dropdown computed styles:', {
                position: dropdownStyles.position,
                zIndex: dropdownStyles.zIndex,
                display: dropdownStyles.display,
                visibility: dropdownStyles.visibility,
                opacity: dropdownStyles.opacity,
                top: dropdownStyles.top,
                right: dropdownStyles.right,
                transform: dropdownStyles.transform
            });
            
            console.log('📍 Textarea computed styles:', {
                position: textareaStyles.position,
                zIndex: textareaStyles.zIndex,
                display: textareaStyles.display
            });
            
            console.log('📍 Dropdown bounding rect:', dropdown.getBoundingClientRect());
            console.log('📍 Textarea bounding rect:', textarea?.getBoundingClientRect());
            
            // First, set textarea z-index to base BEFORE opening dropdown
            if (textarea) {
                textarea.style.zIndex = 'var(--z-base)';
                textarea.style.position = 'relative';
                console.log('📝 Textarea z-index set to var(--z-base) (behind dropdown) - BEFORE opening');
            }
            
            // Force z-index to ensure dropdown appears above everything
            dropdown.style.zIndex = 'var(--z-dropdown)';
            dropdown.style.position = 'fixed';
            
            // Determine layout and apply appropriate classes
            const layout = detectDropdownLayout();
            const dropdownContent = document.getElementById('dropdownContent');
            
            if (dropdownContent) {
                // Remove existing layout classes
                dropdownContent.classList.remove('horizontal-layout', 'vertical-layout');
                // Add new layout class
                dropdownContent.classList.add(`${layout}-layout`);
                console.log(`📐 Applied ${layout} layout to dropdown`);
            }
            
            // Calculate position relative to status indicator
            const statusIndicator = document.getElementById('statusIndicator');
            if (statusIndicator) {
                const rect = statusIndicator.getBoundingClientRect();
                
                if (layout === 'vertical') {
                    // For vertical layout, position to the left of status indicator using CSS constants
                    const verticalOffsetX = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--vertical-dropdown-offset-x')) || -10;
                    const verticalOffsetY = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--vertical-dropdown-offset-y')) || 0;
                    const verticalTransform = getComputedStyle(document.documentElement).getPropertyValue('--vertical-dropdown-transform') || 'translateX(-100%)';
                    
                    dropdown.style.top = `${rect.top + verticalOffsetY}px`;
                    dropdown.style.left = `${rect.left + verticalOffsetX}px`;
                    dropdown.style.transform = verticalTransform;
                } else {
                    // For horizontal layout, position below status indicator using CSS constants
                    const horizontalOffsetX = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--dropdown-offset-x')) || 0;
                    const horizontalOffsetY = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--dropdown-offset-y')) || 4;
                    
                    dropdown.style.top = `${rect.bottom + horizontalOffsetY}px`;
                    dropdown.style.left = `${rect.left + (rect.width / 2) + horizontalOffsetX}px`;
                    dropdown.style.transform = 'translateX(-50%)';
                }
            }
            
            // CRITICAL: Set high z-index for ALL dropdown elements BEFORE opening
            if (dropdownContent) {
                const allUserItems = dropdownContent.querySelectorAll('.user-item');
                const allEmojiCircles = dropdownContent.querySelectorAll('.user-emoji-circle');
                const allTooltips = dropdownContent.querySelectorAll('.user-tooltip');
                
