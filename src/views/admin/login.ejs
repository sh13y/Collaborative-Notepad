<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Admin Login - Collaborative Notepad</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .login-container {
            max-width: 400px;
            margin: 50px auto;
            padding: 2rem;
            background: var(--eggshell);
            border-radius: 12px;
            box-shadow: var(--shadow);
            text-align: center;
        }
        .login-container h2 {
            margin-bottom: 1rem;
            color: var(--delft-blue);
        }
        .login-form {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }
        .login-form input {
            padding: 0.5rem;
            border: 1px solid var(--cambridge-blue);
            border-radius: 4px;
            text-align: left;
        }
        .login-form input::placeholder {
            text-align: center;
            color: var(--cambridge-blue);
            opacity: 0.7;
            text-align-last: center;
        }
        .login-form button {
            background: var(--cambridge-blue);
            color: var(--eggshell);
            padding: 0.5rem;
            border: none;
            border-radius: 4px;
            cursor: pointer;
        }
        .error {
            color: var(--burnt-sienna);
            margin-bottom: 1rem;
        }
    </style>
</head>
<body class="light-mode">
    <div class="login-container">
        <h2><%= firstTime ? 'Set Admin Password' : 'Admin Login' %></h2>
        <% if (locals.error) { %>
            <div class="error"><%= error %></div>
        <% } %>
        <form class="login-form" method="POST" action="/admin/login">
            <input type="password" name="password" placeholder="Enter password" required>
            <button type="submit"><%= firstTime ? 'Set Password' : 'Login' %></button>
        </form>
    </div>
</body>
</html> 