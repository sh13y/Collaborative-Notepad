<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Admin Login - Collaborative Notepad</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 512 512'><path fill='%23fefae0' d='M471.6 21.7c-21.9-21.9-57.3-21.9-79.2 0L362.3 51.7l97.9 97.9 30.1-30.1c21.9-21.9 21.9-57.3 0-79.2L471.6 21.7zm-299.2 220c-6.1 6.1-10.8 13.6-13.5 21.9l-29.6 88.8c-2.9 8.6-.6 18.1 5.8 24.6s15.9 8.7 24.6 5.8l88.8-29.6c8.2-2.7 15.7-7.4 21.9-13.5L437.7 172.3 339.7 74.3 172.4 241.7zM96 64C43 64 0 107 0 160V416c0 53 43 96 96 96H352c53 0 96-43 96-96V320c0-17.7-14.3-32-32-32s-32 14.3-32 32v96c0 17.7-14.3 32-32 32H96c-17.7 0-32-14.3-32-32V160c0-17.7 14.3-32 32-32h96c17.7 0 32-14.3 32-32s-14.3-32-32-32H96z'/></svg>"/>
    <style>
        body {
            min-height: 100vh;
            margin: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0; /* Remove padding to allow full-screen on mobile */
            box-sizing: border-box;
        }

        .login-container {
            width: 100%;
            max-width: 400px;
            margin: 0 auto;
            padding: clamp(2rem, 5vw, 3rem);
            background: var(--eggshell);
            border-radius: 12px;
            box-shadow: var(--shadow);
            text-align: center;
            box-sizing: border-box;
        }
        .login-container h2 {
            margin-bottom: 2rem;
            color: var(--delft-blue);
            font-size: clamp(1.8rem, 5vw, 2.2rem);
        }
        .login-form {
            display: flex;
            flex-direction: column;
            gap: 2rem;
            width: 100%;
        }
        .login-form input {
            width: 100%;
            padding: 1.2rem;
            font-size: 1.1rem;
            border: 2px solid var(--cambridge-blue);
            border-radius: 8px;
            transition: all 0.3s ease;
            background: var(--eggshell);
            text-align: left;
        }
        .login-form input:focus {
            outline: none;
            border-color: var(--delft-blue);
            box-shadow: 0 0 0 3px rgba(96, 108, 56, 0.1);
        }
        .login-form input::placeholder {
            text-align: center;
            color: var(--cambridge-blue);
            opacity: 0.7;
        }
        .login-form button {
            background: var(--cambridge-blue);
            color: var(--eggshell);
            padding: 1.2rem;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-size: 1.1rem;
            font-weight: 500;
            transition: all 0.3s ease;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        .login-form button:hover {
            background: var(--delft-blue);
            transform: translateY(-1px);
        }
        .login-form button:active {
            transform: translateY(1px);
        }
        .error {
            color: var(--burnt-sienna);
            margin-bottom: 1rem;
            padding: 0.8rem;
            border-radius: 8px;
            background: rgba(188, 108, 37, 0.1);
            font-size: clamp(0.8rem, 2vw, 0.9rem);
        }
        .password-container {
            position: relative;
            width: 100%;
            display: flex;
            align-items: center;
        }
        
        .password-toggle {
            position: absolute;
            right: 15px;  /* Adjusted position */
            top: 50%;
            transform: translateY(-50%);
            cursor: pointer;
            color: var(--cambridge-blue);
            opacity: 0.7;
            transition: all 0.3s ease;
            font-size: 1.2rem;  /* Fixed size */
            padding: 8px;  /* Larger click area */
            z-index: 2;  /* Ensure icon stays above input */
        }
        
        .password-toggle:hover {
            opacity: 1;
            color: var(--delft-blue);
        }
        
        /* Dark mode adjustments */
        body.dark-mode .login-container {
            background: var(--delft-blue);
        }
        body.dark-mode .login-container h2 {
            color: var(--eggshell);
        }
        body.dark-mode .login-form input {
            background: var(--delft-blue);
            border-color: var(--cambridge-blue);
            color: var(--eggshell);
        }
        body.dark-mode .login-form input::placeholder {
            color: var(--cambridge-blue);
        }
        body.dark-mode .password-toggle {
            color: var(--cambridge-blue);
        }
        body.dark-mode .password-toggle:hover {
            color: var(--eggshell);
        }
        /* Mobile optimizations */
        @media (max-width: 480px) {
            body {
                padding: 0;
                background: var(--eggshell);
            }
            
            .login-container {
                min-height: 100vh;
                height: 100vh;
                max-width: 100%;
                border-radius: 0;
                padding: 2rem;
                margin: 0;
                display: flex;
                flex-direction: column;
                justify-content: center;
                gap: 2rem;
            }

            .login-form {
                gap: 2rem;
                flex: 0 1 auto;
            }

            .login-form input {
                padding: 1.2rem;
                font-size: 16px;
                height: 3.5rem;
            }

            .login-form button {
                padding: 1.2rem;
                height: 3.5rem;
                font-size: 1.1rem;
            }

            .password-container {
                height: 3.5rem;
            }

            .password-toggle {
                font-size: 1.4rem;
                padding: 1rem;
            }
        }

        @media (max-height: 600px) {
            body {
                align-items: center;
                padding: 0;
            }

            .login-container {
                min-height: auto;
                height: auto;
                padding: 2rem;
            }
        }
    </style>
</head>
<body class="light-mode">
    <div class="login-container">
        <h2><%= firstTime ? 'Set Admin Password' : 'Admin Login' %></h2>
        <% if (locals.error) { %>
            <div class="error"><%= error %></div>
        <% } %>
        <form class="login-form" method="POST" action="/<%= secretAdminPath %>/login">
            <div class="password-container">
                <input type="password" name="password" id="password" placeholder="Enter password" required>
                <i class="fas fa-eye password-toggle" id="togglePassword"></i>
            </div>
            <button type="submit"><%= firstTime ? 'Set Password' : 'Login' %></button>
        </form>
    </div>

    <script>
        const togglePassword = document.querySelector('#togglePassword');
        const password = document.querySelector('#password');

        togglePassword.addEventListener('click', function (e) {
            // Toggle the type attribute
            const type = password.getAttribute('type') === 'password' ? 'text' : 'password';
            password.setAttribute('type', type);
            
            // Toggle the eye icon
            this.classList.toggle('fa-eye');
            this.classList.toggle('fa-eye-slash');
        });
    </script>
</body>
</html> 