<!DOCTYPE html>
<html lang="en" class="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - Collaborative Notepad</title>
    <meta name="robots" content="noindex, nofollow">
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 512 512'><path fill='%23606c38' d='M471.6 21.7c-21.9-21.9-57.3-21.9-79.2 0L362.3 51.7l97.9 97.9 30.1-30.1c21.9-21.9 21.9-57.3 0-79.2L471.6 21.7zm-299.2 220c-6.1 6.1-10.8 13.6-13.5 21.9l-29.6 88.8c-2.9 8.6-.6 18.1 5.8 24.6s15.9 8.7 24.6 5.8l88.8-29.6c8.2-2.7 15.7-7.4 21.9-13.5L437.7 172.3 339.7 74.3 172.4 241.7zM96 64C43 64 0 107 0 160V416c0 53 43 96 96 96H352c53 0 96-43 96-96V320c0-17.7-14.3-32-32-32s-32 14.3-32 32v96c0 17.7-14.3 32-32 32H96c-17.7 0-32-14.3-32-32V160c0-17.7 14.3-32 32-32h96c17.7 0 32-14.3 32-32s-14.3-32-32-32H96z'/></svg>"/>

    <!-- Google Fonts & Tailwind CDN -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        darkMode: 'class',
        theme: {
          extend: {
            colors: {
              earth: {
                cream: '#fefae0',
                creamDark: '#f7f4d3',
                olive: '#606c38',
                oliveDark: '#4d572c',
                forest: '#283618',
                burnt: '#bc6c25',
                terracotta: '#dda15e',
                muted: '#737f51',
                darkBg: '#182012',
                darkCard: '#212c1a',
                darkEditor: '#1c2616',
                darkBorder: '#354522',
              }
            },
            fontFamily: {
              sans: ['"Plus Jakarta Sans"', 'sans-serif'],
              mono: ['"JetBrains Mono"', 'monospace'],
            }
          }
        }
      }
    </script>
    <link rel="stylesheet" href="/css/theme.css">
</head>
<body class="bg-earth-cream text-earth-forest font-sans min-h-screen flex flex-col transition-colors duration-300 antialiased selection:bg-earth-terracotta/30 selection:text-earth-forest dark:bg-earth-darkBg dark:text-earth-cream">

  <!-- Top App Bar -->
  <header class="sticky top-0 z-50 bg-white/85 dark:bg-earth-darkBg/85 backdrop-blur-md border-b border-earth-olive/20 dark:border-earth-darkBorder shadow-sm w-full">
    <div class="max-w-7xl mx-auto h-16 px-4 md:px-6 lg:px-8 flex items-center justify-between gap-4">
      <!-- Brand & Section Context -->
      <div class="flex items-center gap-3 shrink-0">
        <div class="w-9 h-9 rounded-xl bg-earth-olive text-earth-cream flex items-center justify-center shadow-sm">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
          </svg>
        </div>
        <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-2">
          <span class="font-bold text-base text-earth-forest dark:text-earth-cream tracking-tight">Collaborative Notepad</span>
          <div class="flex items-center gap-1.5">
            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-earth-burnt/15 text-earth-burnt border border-earth-burnt/25">
              Admin Portal
            </span>
            <span class="text-earth-forest/40 dark:text-earth-cream/40 text-xs">/</span>
            <span class="text-xs font-semibold text-earth-forest/80 dark:text-earth-cream/80">Dashboard</span>
          </div>
        </div>
      </div>

      <!-- Real-time Cluster Telemetry Status Strip -->
      <div class="hidden lg:flex items-center gap-3 px-3.5 py-1.5 rounded-xl bg-earth-cream/70 dark:bg-earth-darkCard/70 border border-earth-olive/20 dark:border-earth-darkBorder text-xs text-earth-forest/70 dark:text-earth-cream/70">
        <div class="flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span class="font-semibold text-earth-forest dark:text-earth-cream">Operational</span>
          <span class="text-[10px] text-earth-forest/50 dark:text-earth-cream/50">v3.0.0</span>
        </div>
        <span class="text-earth-forest/30 dark:text-earth-cream/30">•</span>
        <div class="flex items-center gap-1">
          <span class="font-mono font-bold text-earth-olive dark:text-earth-terracotta" id="liveClock">UTC</span>
        </div>
        <span class="text-earth-forest/30 dark:text-earth-cream/30">•</span>
        <span class="font-mono text-[11px]">Worker: Active</span>
      </div>

      <!-- Trailing Action Navigation -->
      <div class="flex items-center gap-2 sm:gap-3 shrink-0">
        <a href="/" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-earth-cream/80 dark:bg-earth-darkCard hover:bg-earth-olive/10 text-earth-forest dark:text-earth-cream text-xs font-medium border border-earth-olive/20 dark:border-earth-darkBorder active:scale-95 transition-all">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
          </svg>
          <span class="hidden sm:inline">Live Notepad</span>
        </a>
        <a href="/<%= secretAdminPath %>/logout" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-red-500/10 hover:bg-red-500/20 text-red-600 dark:text-red-400 text-xs font-semibold border border-red-500/20 active:scale-95 transition-all" title="Sign out of Admin Portal">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
          </svg>
          <span class="hidden md:inline">Logout</span>
        </a>
      </div>
    </div>
  </header>

  <!-- Main Dashboard Content -->
  <main class="flex-1 w-full max-w-7xl mx-auto px-4 md:px-6 lg:px-8 py-6 space-y-6">
    <!-- Page Title & Overview -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3 pb-2 border-b border-earth-olive/20 dark:border-earth-darkBorder">
      <div>
        <h1 class="text-2xl font-bold text-earth-forest dark:text-earth-cream tracking-tight">Admin Dashboard & Storage Fleet</h1>
        <p class="text-xs text-earth-forest/70 dark:text-earth-cream/60 mt-0.5">Real-time socket memory monitoring, automated garbage collection, and stale buffer maintenance.</p>
      </div>
      <div class="flex items-center gap-2 self-start md:self-auto">
        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-white/70 dark:bg-earth-darkCard text-earth-olive dark:text-earth-terracotta text-xs font-medium border border-earth-olive/20 dark:border-earth-darkBorder">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
          </svg>
          Sync Engine: Socket.IO v4
        </span>
      </div>
    </div>

    <!-- Error banner if any -->
    <% if (locals.error) { %>
      <div class="p-3.5 rounded-xl bg-red-500/10 border border-red-500/30 text-red-600 dark:text-red-400 text-xs flex items-center gap-2">
        <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <span><%= error %></span>
      </div>
    <% } %>

    <!-- Stats Row (3 Prominent Cards) -->
    <section class="grid grid-cols-1 md:grid-cols-3 gap-4 lg:gap-6">
      <!-- Card 1: Active Notes (Live) -->
      <div class="bg-white/80 dark:bg-earth-darkCard rounded-2xl border border-earth-olive/25 dark:border-earth-darkBorder p-5 shadow-sm hover:border-earth-olive/50 transition-all relative overflow-hidden group">
        <div class="flex items-start justify-between">
          <div class="space-y-1">
            <span class="text-xs font-semibold text-earth-forest/70 dark:text-earth-cream/70 uppercase tracking-wider">Active Notes (Live)</span>
            <div class="flex items-baseline gap-2">
              <span id="activeNotesCount" class="text-3xl font-bold text-earth-olive dark:text-earth-cream transition-transform duration-300 inline-block">
                <%= typeof activeNotesCount !== 'undefined' ? activeNotesCount : 0 %>
              </span>
              <span class="text-[11px] font-semibold text-emerald-600 dark:text-emerald-400 inline-flex items-center bg-emerald-500/10 px-1.5 py-0.5 rounded">
                Live
              </span>
            </div>
            <p class="text-xs text-earth-forest/60 dark:text-earth-cream/50">Synced via WebSockets across rooms</p>
          </div>
          <div class="w-10 h-10 rounded-xl bg-earth-olive/10 text-earth-olive dark:text-earth-terracotta flex items-center justify-center shrink-0">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
            </svg>
          </div>
        </div>
        <div class="mt-4 pt-3 border-t border-earth-olive/15 dark:border-earth-darkBorder flex items-center justify-between text-xs text-earth-forest/70 dark:text-earth-cream/60">
          <span class="flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            Real-time socket listeners
          </span>
        </div>
      </div>

      <!-- Card 2: Total Notes & Storage -->
      <div class="bg-white/80 dark:bg-earth-darkCard rounded-2xl border border-earth-olive/25 dark:border-earth-darkBorder p-5 shadow-sm hover:border-earth-olive/50 transition-all relative overflow-hidden group">
        <div class="flex items-start justify-between">
          <div class="space-y-1">
            <span class="text-xs font-semibold text-earth-forest/70 dark:text-earth-cream/70 uppercase tracking-wider">Total Stored Notes</span>
            <div class="flex items-baseline gap-2">
              <span class="text-3xl font-bold text-earth-forest dark:text-earth-cream">
                <%= typeof notes !== 'undefined' ? notes.length : 0 %>
              </span>
              <span class="text-xs text-earth-forest/60 dark:text-earth-cream/50">records in DB</span>
            </div>
            <p class="text-xs text-earth-forest/60 dark:text-earth-cream/50">Persistent MongoDB document collections</p>
          </div>
          <div class="w-10 h-10 rounded-xl bg-earth-forest/10 text-earth-forest dark:text-earth-cream flex items-center justify-center shrink-0">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2 1.5 3 3.5 3h9c2 0 3.5-1 3.5-3V7c0-2-1.5-3-3.5-3h-9C5.5 4 4 5 4 7z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6"/>
            </svg>
          </div>
        </div>
        <div class="mt-4 pt-3 border-t border-earth-olive/15 dark:border-earth-darkBorder flex items-center justify-between text-xs text-earth-forest/70 dark:text-earth-cream/60">
          <span>Storage engine: <strong>Mongoose</strong></span>
          <span class="text-emerald-600 dark:text-emerald-400 font-medium">Auto-indexed</span>
        </div>
      </div>

      <!-- Card 3: Empty Notes & Cleanup -->
      <div class="bg-white/80 dark:bg-earth-darkCard rounded-2xl border border-earth-burnt/30 dark:border-earth-darkBorder p-5 shadow-sm hover:border-earth-burnt/60 transition-all relative overflow-hidden group">
        <div class="flex items-start justify-between">
          <div class="space-y-1">
            <span class="text-xs font-semibold text-earth-burnt uppercase tracking-wider">Empty / Orphaned Notes</span>
            <div class="flex items-baseline gap-2">
              <span class="text-3xl font-bold text-earth-burnt">
                <%= typeof emptyNotesCount !== 'undefined' ? emptyNotesCount : 0 %>
              </span>
              <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-semibold bg-earth-burnt/10 text-earth-burnt">
                Cleanup Target
              </span>
            </div>
            <p class="text-xs text-earth-forest/60 dark:text-earth-cream/50">Blank or abandoned scratchpads</p>
          </div>
          <div class="w-10 h-10 rounded-xl bg-earth-burnt/10 text-earth-burnt flex items-center justify-center shrink-0">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
            </svg>
          </div>
        </div>
        <div class="mt-4 pt-3 border-t border-earth-olive/15 dark:border-earth-darkBorder flex items-center justify-between text-xs text-earth-forest/70 dark:text-earth-cream/60">
          <div class="flex items-center gap-2">
            <span>&gt;7d Old: <strong id="oldEmptyCount" class="text-earth-burnt">-</strong></span>
            <span>•</span>
            <span>&lt;7d Recent: <strong id="recentEmptyCount">-</strong></span>
          </div>
        </div>
      </div>
    </section>

    <!-- Controls / Action Toolbar -->
    <section class="bg-white/80 dark:bg-earth-darkCard border border-earth-olive/25 dark:border-earth-darkBorder rounded-2xl p-4 shadow-sm flex flex-col xl:flex-row xl:items-center justify-between gap-3">
      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center gap-2.5">
        <!-- Destructive Action -->
        <button id="deleteEmptyNotesBtn" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-earth-burnt hover:bg-earth-burnt/90 text-white text-xs font-semibold shadow-sm active:scale-95 transition-all cursor-pointer">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
          </svg>
          <span>Delete All Empty Notes</span>
        </button>

        <!-- Safe Maintenance Action -->
        <button id="cleanupOldNotesBtn" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-earth-olive/10 hover:bg-earth-olive/20 text-earth-olive dark:text-earth-terracotta border border-earth-olive/30 text-xs font-semibold active:scale-95 transition-all cursor-pointer">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <span>Cleanup Old Empty Notes (&gt;7 days)</span>
        </button>

        <!-- Reset Password Form Action -->
        <form action="/<%= secretAdminPath %>/reset-password" method="POST" class="inline-block m-0" onsubmit="return confirm('Are you sure you want to reset the admin password? You will be prompted to set a new password on your next login.');">
          <button type="submit" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-earth-cream dark:bg-earth-darkEditor hover:bg-earth-creamDark text-earth-forest dark:text-earth-cream border border-earth-olive/20 dark:border-earth-darkBorder text-xs font-semibold active:scale-95 transition-all cursor-pointer">
            <svg class="w-4 h-4 text-earth-terracotta" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>
            </svg>
            <span>Reset Admin Password</span>
          </button>
        </form>
      </div>

      <!-- Right Telemetry Readout -->
      <div class="flex items-center gap-3 px-3 py-1.5 rounded-xl bg-earth-cream/60 dark:bg-earth-darkEditor border border-earth-olive/15 dark:border-earth-darkBorder text-xs text-earth-forest/70 dark:text-earth-cream/60">
        <span class="flex items-center gap-1 text-earth-olive dark:text-earth-terracotta font-semibold">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          Auto-GC: Running
        </span>
        <span>•</span>
        <span>Retention: 7 days</span>
      </div>
    </section>

    <!-- Notes Management Table & Filters -->
    <section class="bg-white/90 dark:bg-earth-darkCard border border-earth-olive/25 dark:border-earth-darkBorder rounded-2xl shadow-sm overflow-hidden flex flex-col">
      <!-- Search Filter Bar -->
      <div class="p-4 border-b border-earth-olive/15 dark:border-earth-darkBorder bg-earth-cream/40 dark:bg-earth-darkEditor/40 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div class="relative flex-1 max-w-md">
          <svg class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-earth-forest/40 dark:text-earth-cream/40" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
          <input type="text" id="noteSearchInput" placeholder="Search notes by URL or content..." class="w-full pl-9 pr-4 py-2 rounded-xl bg-white dark:bg-earth-darkEditor border border-earth-olive/20 dark:border-earth-darkBorder text-xs text-earth-forest dark:text-earth-cream focus:outline-none focus:ring-2 focus:ring-earth-olive/20">
        </div>
        <div class="px-3 py-1.5 rounded-xl bg-earth-cream dark:bg-earth-darkEditor border border-earth-olive/20 dark:border-earth-darkBorder text-xs text-earth-forest/70 dark:text-earth-cream/60 shrink-0">
          Showing <span id="visibleNoteCount" class="font-bold text-earth-forest dark:text-earth-cream"><%= notes ? notes.length : 0 %></span> notes
        </div>
      </div>

      <!-- Table Container -->
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="border-b border-earth-olive/15 dark:border-earth-darkBorder bg-earth-cream/60 dark:bg-earth-darkEditor/60 text-[11px] font-semibold text-earth-forest/70 dark:text-earth-cream/70 uppercase tracking-wider">
              <th class="py-3 px-4" scope="col">Note Slug / URL</th>
              <th class="py-3 px-4 min-w-[240px]" scope="col">Content Snippet Preview</th>
              <th class="py-3 px-4 whitespace-nowrap" scope="col">Last Modified</th>
              <th class="py-3 px-4 whitespace-nowrap" scope="col">Status</th>
              <th class="py-3 px-4 text-right" scope="col">Action</th>
            </tr>
          </thead>
          <tbody id="notesTableBody" class="divide-y divide-earth-olive/10 dark:divide-earth-darkBorder text-xs">
            <% if (notes && notes.length > 0) { %>
              <% notes.forEach(note => { %>
                <tr class="note-row hover:bg-earth-cream/30 dark:hover:bg-earth-darkEditor/30 transition-colors">
                  <td class="py-3 px-4 whitespace-nowrap">
                    <div class="flex items-center gap-2">
                      <a href="/<%= note.url %>" target="_blank" class="font-mono font-bold text-earth-olive hover:underline dark:text-earth-terracotta">
                        /<%= note.url %>
                      </a>
                    </div>
                  </td>
                  <td class="py-3 px-4">
                    <div class="font-mono text-[11px] text-earth-forest/75 dark:text-earth-cream/70 truncate max-w-sm bg-earth-cream/50 dark:bg-earth-darkEditor px-2.5 py-1 rounded-lg border border-earth-olive/10 dark:border-earth-darkBorder">
                      <%= note.content && note.content.trim() ? note.content.substring(0, 90) : '(Empty Note)' %>
                    </div>
                  </td>
                  <td class="py-3 px-4 whitespace-nowrap text-earth-forest/60 dark:text-earth-cream/50 text-[11px]">
                    <%= new Date(note.updatedAt).toLocaleString() %>
                  </td>
                  <td class="py-3 px-4 whitespace-nowrap">
                    <% if (note.content && note.content.trim()) { %>
                      <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-500/15 text-emerald-600 dark:text-emerald-400">
                        Active
                      </span>
                    <% } else { %>
                      <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-earth-burnt/15 text-earth-burnt">
                        Empty
                      </span>
                    <% } %>
                  </td>
                  <td class="py-3 px-4 text-right whitespace-nowrap">
                    <a href="/<%= note.url %>" target="_blank" class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-earth-olive/10 hover:bg-earth-olive hover:text-white text-earth-olive dark:text-earth-terracotta text-xs font-medium transition-colors">
                      <span>View</span>
                      <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                      </svg>
                    </a>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="5" class="py-8 text-center text-earth-forest/50 dark:text-earth-cream/50">
                  No notes recorded yet in the database.
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </section>
  </main>

  <!-- Clean Footer -->
  <footer class="mt-auto border-t border-earth-olive/15 dark:border-earth-darkBorder py-4 bg-white/70 dark:bg-earth-darkBg/70 backdrop-blur-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-earth-forest/70 dark:text-earth-cream/70">
      <div class="flex items-center gap-2">
        <div class="w-2 h-2 rounded-full bg-earth-olive"></div>
        <span>Secured Administrator Console • Node cluster active</span>
      </div>
      <div>
        <span>Built with care by Collaborative Notepad Team • Open Source (MIT)</span>
      </div>
    </div>
  </footer>

  <!-- Socket.IO & Admin Client Interactions -->
  <script src="https://cdn.socket.io/4.7.4/socket.io.min.js"></script>
  <script>
    // UTC Clock
    function updateClock() {
      const now = new Date();
      const clock = document.getElementById('liveClock');
      if (clock) {
        clock.textContent = 'UTC ' + now.toUTCString().split(' ')[4];
      }
    }
    setInterval(updateClock, 1000);
    updateClock();

    // Socket.IO real-time stats update
    let browserId = localStorage.getItem('browserId') || crypto.randomUUID();
    const socket = io({
      query: { browserId },
      transports: ['websocket'],
      upgrade: false
    });

    const activeCountEl = document.getElementById('activeNotesCount');
    socket.on('adminStats', (data) => {
      if (activeCountEl && data && typeof data.activeNotes !== 'undefined') {
        activeCountEl.textContent = data.activeNotes;
        activeCountEl.classList.add('scale-110');
        setTimeout(() => activeCountEl.classList.remove('scale-110'), 300);
      }
    });

    // Cleanup stats loader
    async function loadCleanupStats() {
      try {
        const response = await fetch('/<%= secretAdminPath %>/cleanup-stats');
        const stats = await response.json();
        if (stats.success) {
          const oldEl = document.getElementById('oldEmptyCount');
          const recentEl = document.getElementById('recentEmptyCount');
          if (oldEl) oldEl.textContent = stats.oldEmptyNotes;
          if (recentEl) recentEl.textContent = stats.recentEmptyNotes;
        }
      } catch (err) {
        console.error('Error loading cleanup stats:', err);
      }
    }
    loadCleanupStats();

    // Search filter for table
    const searchInput = document.getElementById('noteSearchInput');
    const noteRows = document.querySelectorAll('.note-row');
    const visibleCountEl = document.getElementById('visibleNoteCount');

    if (searchInput) {
      searchInput.addEventListener('input', () => {
        const query = searchInput.value.toLowerCase().trim();
        let visibleCount = 0;
        noteRows.forEach(row => {
          const text = row.textContent.toLowerCase();
          if (text.includes(query)) {
            row.style.display = '';
            visibleCount++;
          } else {
            row.style.display = 'none';
          }
        });
        if (visibleCountEl) visibleCountEl.textContent = visibleCount;
      });
    }

    // Delete All Empty Notes Action
    const deleteEmptyNotesBtn = document.getElementById('deleteEmptyNotesBtn');
    if (deleteEmptyNotesBtn) {
      deleteEmptyNotesBtn.addEventListener('click', async () => {
        if (!confirm('Are you sure you want to permanently delete all empty notes? This action cannot be undone.')) {
          return;
        }
        deleteEmptyNotesBtn.disabled = true;
        const originalText = deleteEmptyNotesBtn.textContent;
        deleteEmptyNotesBtn.textContent = 'Deleting...';

        try {
          const res = await fetch('/<%= secretAdminPath %>/delete-empty-notes', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
          });
          const result = await res.json();
          if (result.success) {
            alert(`Success! Deleted ${result.deletedCount} empty notes.`);
            window.location.reload();
          } else {
            alert(`Error: ${result.error || 'Failed to delete'}`);
          }
        } catch (err) {
          alert('Network error while deleting empty notes.');
        } finally {
          deleteEmptyNotesBtn.disabled = false;
          deleteEmptyNotesBtn.textContent = originalText;
        }
      });
    }

    // Cleanup Old Empty Notes Action (>7 days)
    const cleanupOldNotesBtn = document.getElementById('cleanupOldNotesBtn');
    if (cleanupOldNotesBtn) {
      cleanupOldNotesBtn.addEventListener('click', async () => {
        if (!confirm('Delete empty notes untouched for more than 7 days?')) {
          return;
        }
        cleanupOldNotesBtn.disabled = true;
        const originalText = cleanupOldNotesBtn.textContent;
        cleanupOldNotesBtn.textContent = 'Cleaning...';

        try {
          const res = await fetch('/<%= secretAdminPath %>/cleanup-old-empty-notes', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
          });
          const result = await res.json();
          if (result.success) {
            alert(`Success! Cleaned up ${result.deletedCount} old empty notes.`);
            window.location.reload();
          } else {
            alert(`Error: ${result.error || 'Failed to cleanup'}`);
          }
        } catch (err) {
          alert('Network error while cleaning up old empty notes.');
        } finally {
          cleanupOldNotesBtn.disabled = false;
          cleanupOldNotesBtn.textContent = originalText;
        }
      });
    }
  </script>
</body>
</html>