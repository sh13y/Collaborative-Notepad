<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title><%= typeof statusCode !== 'undefined' ? statusCode + ' - ' : '' %>Error - Collaborative Notepad</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="robots" content="noindex, nofollow">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 512 512'><path fill='%23fefae0' d='M471.6 21.7c-21.9-21.9-57.3-21.9-79.2 0L362.3 51.7l97.9 97.9 30.1-30.1c21.9-21.9 21.9-57.3 0-79.2L471.6 21.7zm-299.2 220c-6.1 6.1-10.8 13.6-13.5 21.9l-29.6 88.8c-2.9 8.6-.6 18.1 5.8 24.6s15.9 8.7 24.6 5.8l88.8-29.6c8.2-2.7 15.7-7.4 21.9-13.5L437.7 172.3 339.7 74.3 172.4 241.7zM96 64C43 64 0 107 0 160V416c0 53 43 96 96 96H352c53 0 96-43 96-96V320c0-17.7-14.3-32-32-32s-32 14.3-32 32v96c0 17.7-14.3 32-32 32H96c-17.7 0-32-14.3-32-32V160c0-17.7 14.3-32 32-32h96c17.7 0 32-14.3 32-32s-14.3-32-32-32H96z'/></svg>"/>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        body {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .not-found-container {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            flex: 1;
            text-align: center;
            padding: 2rem;
        }

        .error-code {
            font-size: 6rem;
            font-weight: bold;
            color: var(--burnt-sienna);
            margin-bottom: 0.5rem;
            font-family: 'Fira Code', monospace;
        }

        .error-details {
            background: var(--light-delft);
            padding: 1rem;
            border-radius: 8px;
            margin: 1rem 0;
            font-family: 'Fira Code', monospace;
            font-size: 0.9rem;
            text-align: left;
            max-width: 600px;
            overflow-x: auto;
        }

        .help-section {
            margin: 2rem 0;
            padding: 1.5rem;
            background: var(--light-cambridge);
            border-radius: 12px;
            max-width: 500px;
        }

        .help-section h3 {
            color: var(--delft-blue);
            margin-bottom: 1rem;
        }

        .help-section ul {
            text-align: left;
            color: var(--cambridge-blue);
        }

        .help-section li {
            margin: 0.5rem 0;
        }

        .action-buttons {
            margin: 2rem 0;
            display: flex;
            gap: 1rem;
            justify-content: center;
            flex-wrap: wrap;
        }

        .btn {
            padding: 0.8rem 1.5rem;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            text-decoration: none;
            font-weight: 600;
            transition: all 0.3s ease;
            display: inline-block;
        }

        .btn-primary {
            background: var(--cambridge-blue);
            color: var(--eggshell);
        }

        .btn-primary:hover {
            background: var(--delft-blue);
            transform: translateY(-2px);
        }

        .btn-secondary {
            background: var(--light-delft);
            color: var(--delft-blue);
            border: 2px solid var(--cambridge-blue);
        }

        .btn-secondary:hover {
            background: var(--cambridge-blue);
            color: var(--eggshell);
        }

        .not-found-message {
            font-size: 1.5rem;
            color: var(--delft-blue);
            margin-bottom: 1rem;
        }

        .redirect-message {
            font-size: 1rem;
            color: var(--cambridge-blue);
        }

        .countdown {
            font-weight: bold;
            color: var(--burnt-sienna);
        }

        footer {
            margin-top: auto;
        }

        @keyframes bounce {
            0%, 20%, 50%, 80%, 100% {
                transform: translateY(0);
            }
            40% {
                transform: translateY(-20px);
            }
            60% {
                transform: translateY(-10px);
            }
        }

        body.dark-mode .not-found-message {
            color: var(--eggshell);
        }

        body.dark-mode .redirect-message {
            color: var(--sunset);
        }
    </style>
</head>
<body class="light-mode">
    <%- include('partials/donate-banner') %>
    <header>
        <div class="header-content">
            <div class="logo">
                <i class="fas fa-edit"></i>
                <h1>Collaborative Notepad</h1>
            </div>
        </div>
    </header>

    <div class="not-found-container">
        <% if (typeof statusCode !== 'undefined') { %>
            <div class="error-code"><%= statusCode %></div>
        <% } else { %>
            <i class="fas fa-file-circle-question not-found-icon"></i>
        <% } %>
        
        <div class="not-found-message"><%= message %></div>
        
        <% if (typeof error !== 'undefined' && error) { %>
            <details class="error-details">
                <summary>Technical Details (Development Mode)</summary>
                <pre><%= error %></pre>
            </details>
        <% } %>

        <div class="help-section">
            <h3>What you can do:</h3>
            <ul>
                <li>Check the URL for typos</li>
                <li>Create a new collaborative note</li>
                <li>Visit the homepage</li>
                <li>Contact support if this is unexpected</li>
            </ul>
        </div>

        <div class="action-buttons">
            <a href="/new" class="btn btn-primary">
                <i class="fas fa-plus"></i> Create New Note
            </a>
            <a href="/" class="btn btn-secondary">
                <i class="fas fa-home"></i> Go Home
            </a>
        </div>

        <% if (typeof redirectUrl !== 'undefined' && redirectUrl) { %>
            <div class="redirect-message">
                Auto-redirecting in <span class="countdown">5</span> seconds...
            </div>
        <% } %>
    </div>

    <footer>
        <div class="footer-content">
            <div class="copyright">
                © 2025 | made in ceylon with ❤️ by sh13y
            </div>
            <div class="footer-links">
                <a href="http://paypal.me/shieyz" target="_blank">
                    <i class="fab fa-paypal"></i>
                    Fix My Back Pain
                </a>
            </div>
        </div>
    </footer>

    <script>
        // Check for saved theme
        const savedTheme = localStorage.getItem('theme');
        if (savedTheme) {
            document.body.classList.remove('light-mode', 'dark-mode');
            document.body.classList.add(savedTheme);
        }

        // Countdown and redirect
        const countdownElement = document.querySelector('.countdown');
        if (countdownElement) {
            let count = 5;
            const redirectUrl = '<%= typeof redirectUrl !== "undefined" && redirectUrl ? redirectUrl : "/new" %>';
            
            const interval = setInterval(() => {
                count--;
                countdownElement.textContent = count;
                if (count <= 0) {
                    clearInterval(interval);
                    window.location.href = redirectUrl;
                }
            }, 1000);
        }
    </script>
</body>
</html> 