# MongoDB Connection URI (Required)
# Replace with your actual MongoDB URI
MONGODB_URI=mongodb+srv://your_username:your_password@your_cluster.mongodb.net/your_database?retryWrites=true&w=majority&appName=your_app_name

# Port for the server (Optional, defaults to 3000)
PORT=3000

# Session secret for secure cookie signing (Required)
# Generate a long, random string for production
SESSION_SECRET=your-super-secret-session-key-change-this-in-production

# Secret admin path - change this to something only you know (Required)
# This path will be used to access the admin panel: /your-secret-path
# Examples: admin-xyz123, secret-panel-abc, my-admin-2024
ADMIN_SECRET_PATH=your-secret-admin-path

# Node Environment (Optional, defaults to development)
# Set to 'production' for enhanced security and performance
NODE_ENV=production

# Security Settings (Production Only)
# These are automatically applied when NODE_ENV=production
# - Enhanced Content Security Policy
# - Strict Transport Security (HTTPS)
# - Suspicious request monitoring
# - Additional security headers 